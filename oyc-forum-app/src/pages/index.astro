---
const categories = [
  "Announcements",
  "General Discussion",
  "Racing",
  "Cruising",
  "Crew Wanted",
  "Buy/Sell Trade",
  "Photos",
  "Board Only"
];
---

<html>
  <head>
    <title>OYC Forum</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }

      h1 {
        color: #003366;
      }

      .category {
        border: 1px solid #ddd;
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 6px;
      }

      .category:hover {
        background: #f8f8f8;
      }

      a {
        text-decoration: none;
        color: #003366;
      }
    </style>
  </head>

  <body>
    <h1>Oshkosh Yacht Club Forum</h1>

    <p>
      Private discussion forum for club members.
    </p>

    {
      categories.map(category => (
        <div class="category">
          <h2>{category}</h2>
        </div>
      ))
    }
  </body>
</html>
