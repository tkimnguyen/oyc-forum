---
import { env } from "cloudflare:workers";
import { canAccessCategory } from "../lib/roles";
import Layout from "../layouts/Layout.astro";

const user = Astro.locals.user;

const result = await env.DB
  .prepare(`
    SELECT
      categories.id,
      categories.name,
      categories.description,
      categories.minimum_role,
      categories.enabled,
      (SELECT COUNT(*) FROM topics WHERE topics.category_id = categories.id) AS topic_count,
      (
        SELECT MAX(posts.created_at)
        FROM posts
        JOIN topics ON topics.id = posts.topic_id
        WHERE topics.category_id = categories.id
      ) AS last_post_at
    FROM categories
    ORDER BY id
  `)
  .all();

const categories = (result.results || [])
  .filter((category) => category.enabled)
  .filter((category) => canAccessCategory(user?.role, category.minimum_role));

let pendingCount = 0;

if (user?.role === "admin") {
  const pendingResult = await env.DB
    .prepare(`SELECT COUNT(*) AS count FROM users WHERE approved = 0`)
    .first();

  pendingCount = pendingResult?.count ?? 0;
}

let unreadGroupCount = 0;

if (user?.approved) {
  const unreadResult = await env.DB
    .prepare(`
      SELECT COUNT(*) AS count
      FROM group_messages
      JOIN user_groups ON user_groups.group_id = group_messages.group_id
        AND user_groups.user_id = ?
      LEFT JOIN group_message_reads ON group_message_reads.group_id = group_messages.group_id
        AND group_message_reads.user_id = user_groups.user_id
      WHERE group_messages.author_id != ?
        AND group_messages.created_at > COALESCE(group_message_reads.last_read_at, user_groups.created_at)
    `)
    .bind(user.id, user.id)
    .first();

  unreadGroupCount = unreadResult?.count ?? 0;
}
---

<Layout title="OYC Forum">
  <div class="navbar">
    {user && <span>Logged in as {user.email} ({user.role})</span>}

    <div class="nav-actions">
      <a href="https://tempestwx.com/station/115814/" target="_blank" rel="noopener noreferrer">
        Weather Station
      </a>

      {user ? (
        <>
          {user.approved && <a href="/directory">Directory</a>}
          {user.approved && <a href="/calendar">Calendar</a>}
          {user.approved && (
            <a href="/my-groups">
              My Groups{unreadGroupCount > 0 && ` (${unreadGroupCount})`}
            </a>
          )}
          <a href="/profile">Edit My Info</a>

          {user.role === "admin" && (
            <>
              {pendingCount > 0 && (
                <a href="/admin/members">Pending Members ({pendingCount})</a>
              )}
              <a href="/admin/categories">Manage Categories</a>
              <a href="/admin/users">Manage Users</a>
              <a href="/admin/groups">Manage Groups</a>
              <a href="/admin/storage">Storage & Stats</a>
            </>
          )}

          <form method="POST" action="/api/logout">
            <button type="submit">Log Out</button>
          </form>
        </>
      ) : (
        <a href="/login">Log In</a>
      )}
    </div>
  </div>

  <h1>Oshkosh Yacht Club Forum</h1>

  {user?.approved && (
    <p><a class="btn" href="/calendar">View Calendar</a></p>
  )}

  {categories.map((category) => (
    <div class="card">
      <h2><a href={`/category/${category.id}`}>{category.name}</a></h2>
      <p>{category.description}</p>
      <p class="meta">
        {category.topic_count} {category.topic_count === 1 ? "topic" : "topics"}
        {category.last_post_at && <> &middot; Last activity: {category.last_post_at}</>}
      </p>
    </div>
  ))}
</Layout>
