---
import Layout from "../layouts/Layout.astro";
import { fetchUpcomingEvents } from "../lib/calendar";
import { fetchWindForecastFor } from "../lib/tempest";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/login");
}

if (!user.approved) {
  return Astro.redirect("/pending-approval");
}

const { events, error } = await fetchUpcomingEvents();

// A "race" is any event whose title starts with "Class " (e.g. "Class E
// Boat"), per the club's naming convention on this calendar.
const nextRace = events.find((event) => event.title.trim().toLowerCase().startsWith("class "));

let windForecast = null;
let windForecastError: string | null = null;

if (nextRace) {
  const result = await fetchWindForecastFor(nextRace.start);
  windForecast = result.forecast;
  windForecastError = result.error;
}

const TZ = "America/Chicago";
const dateFmt = new Intl.DateTimeFormat("en-US", {
  timeZone: TZ,
  weekday: "short",
  month: "short",
  day: "numeric",
});
const timeFmt = new Intl.DateTimeFormat("en-US", {
  timeZone: TZ,
  hour: "numeric",
  minute: "2-digit",
});
// Used only to compare calendar days in the club's own timezone — the
// server's UTC "today" can be a different local day than Chicago's.
const dayKeyFmt = new Intl.DateTimeFormat("en-CA", {
  timeZone: TZ,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const todayKey = dayKeyFmt.format(new Date());
const tomorrowKey = dayKeyFmt.format(new Date(Date.now() + 24 * 60 * 60 * 1000));

function dayLabel(event: { start: Date }): string | null {
  const key = dayKeyFmt.format(event.start);
  if (key === todayKey) return "Today";
  if (key === tomorrowKey) return "Tomorrow";
  return null;
}

function formatEventWhen(event: { start: Date; end: Date | null; allDay: boolean }): string {
  if (event.allDay) {
    const lastDay = event.end ? new Date(event.end.getTime() - 24 * 60 * 60 * 1000) : event.start;
    if (lastDay.getTime() > event.start.getTime()) {
      return `${dateFmt.format(event.start)} – ${dateFmt.format(lastDay)} · All day`;
    }
    return `${dateFmt.format(event.start)} · All day`;
  }

  const datePart = dateFmt.format(event.start);
  const startTime = timeFmt.format(event.start);
  const endTime = event.end ? timeFmt.format(event.end) : null;
  return endTime ? `${datePart} · ${startTime}–${endTime}` : `${datePart} · ${startTime}`;
}
---

<Layout title="Calendar">
  <p class="back-link"><a href="/">&larr; Back to forum</a></p>
  <h1>Calendar</h1>

  <p>
    <a
      href="https://calendar.google.com/calendar/embed?src=j0n9v98vs612ojg04bfinil068%40group.calendar.google.com&ctz=America%2FChicago"
      target="_blank"
      rel="noopener noreferrer"
    >
      View full calendar on Google &rarr;
    </a>
  </p>

  {nextRace && (
    <div class="card">
      <h2>Wind forecast for next race: {nextRace.title}</h2>
      <p class="meta">{formatEventWhen(nextRace)}</p>

      {windForecastError && <p class="meta">{windForecastError}</p>}

      {windForecast && (
        <p>
          {windForecast.windAvgMph} mph avg, gusting {windForecast.windGustMph} mph,
          from {windForecast.windDirectionCardinal}
          {windForecast.approximate && (
            <span class="meta">
              {" "}(nearest available forecast hour, {timeFmt.format(windForecast.forecastTime)})
            </span>
          )}
        </p>
      )}

      <p class="meta">
        <a
          href="https://tempestwx.com/station/115814/"
          target="_blank"
          rel="noopener noreferrer"
        >
          View station on Tempest &rarr;
        </a>
      </p>
    </div>
  )}

  {error && <p class="notice">{error}</p>}

  {!error && events.length === 0 && <p>No upcoming events in the next 90 days.</p>}

  {events.map((event) => (
    <div class="card">
      <h2>
        {dayLabel(event) && <span class="tag">{dayLabel(event)}</span>}
        {event.title}
      </h2>
      <p class="meta">{formatEventWhen(event)}</p>
      {event.location && <p class="meta">{event.location}</p>}
      {event.description && <p>{event.description}</p>}
    </div>
  ))}
</Layout>
