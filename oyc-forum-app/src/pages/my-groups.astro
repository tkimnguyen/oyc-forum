---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/login");
}

if (!user.approved) {
  return Astro.redirect("/pending-approval");
}

const result = await env.DB
  .prepare(`
    SELECT
      groups.id,
      groups.name,
      groups.description,
      (SELECT COUNT(*) FROM group_messages WHERE group_messages.group_id = groups.id) AS message_count,
      (
        SELECT COUNT(*)
        FROM group_messages
        WHERE group_messages.group_id = groups.id
          AND group_messages.author_id != user_groups.user_id
          AND group_messages.created_at > COALESCE(
            (
              SELECT last_read_at FROM group_message_reads
              WHERE group_message_reads.group_id = groups.id
                AND group_message_reads.user_id = user_groups.user_id
            ),
            user_groups.created_at
          )
      ) AS unread_count
    FROM user_groups
    JOIN groups ON groups.id = user_groups.group_id
    WHERE user_groups.user_id = ?
    ORDER BY groups.name
  `)
  .bind(user.id)
  .all();

const myGroups = result.results || [];
---

<Layout title="My Groups">
  <p class="back-link"><a href="/">&larr; Back to forum</a></p>
  <h1>My Groups</h1>

  {myGroups.length === 0 && (
    <p>You're not in any groups yet. Ask an admin to add you to a fleet group.</p>
  )}

  {myGroups.map((group) => (
    <div class="card">
      <h2>
        <a href={`/groups/${group.id}`}>{group.name}</a>
        {group.unread_count > 0 && (
          <span class="tag">{group.unread_count} unread</span>
        )}
      </h2>
      {group.description && <p>{group.description}</p>}
      <p class="meta">
        {group.message_count} {group.message_count === 1 ? "message" : "messages"}
      </p>
    </div>
  ))}
</Layout>
