---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";

const user = Astro.locals.user;

if (!user || user.role !== "admin") {
  return Astro.redirect("/");
}

const result = await env.DB
  .prepare(`SELECT id, email, name, created_at FROM users WHERE approved = 0 ORDER BY created_at`)
  .all();

const pendingUsers = result.results || [];
---

<Layout title="Pending Members">
  <p class="back-link"><a href="/">&larr; Back to forum</a></p>
  <h1>Pending Members</h1>

  {pendingUsers.length === 0 && <p>No one is waiting on approval.</p>}

  {pendingUsers.map((pending) => (
    <div class="card">
      <span>{pending.email}</span>
      {" "}
      <form method="POST" action="/api/admin/approve-member" style="display:inline; padding:0; border:none; background:none; margin:0;">
        <input type="hidden" name="user_id" value={pending.id} />
        <button type="submit">Approve</button>
      </form>
    </div>
  ))}
</Layout>
