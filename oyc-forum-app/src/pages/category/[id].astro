---
import { env } from "cloudflare:workers";

const id = Astro.params.id;

const result = await env.DB
  .prepare(`
      SELECT *
      FROM topics
      WHERE category_id = ?
      ORDER BY created_at DESC
  `)
  .bind(id)
  .all();

const topics = result.results || [];
---

<html>
<body>

<h1>Category</h1>

{
  topics.map(topic => (
    <div>
      <a href={`/topic/${topic.id}`}>
        {topic.title}
      </a>
    </div>
  ))
}

</body>
</html>
