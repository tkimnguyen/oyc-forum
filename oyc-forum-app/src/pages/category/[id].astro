---
const id = Astro.params.id;

const db = Astro.locals.runtime?.env?.DB;

let topic = null;
let posts = [];

if (db) {
  topic = await db
    .prepare(
      `SELECT *
       FROM topics
       WHERE id = ?`
    )
    .bind(id)
    .first();

  const result = await db
    .prepare(
      `SELECT *
       FROM posts
       WHERE topic_id = ?
       ORDER BY created_at`
    )
    .bind(id)
    .all();

  posts = result.results || [];
}
---

<html>
<head>
  <title>{topic?.title}</title>
</head>

<body>

<h1>{topic?.title}</h1>

{
  posts.map(post => (
      <article>
        <hr />
        <p>{post.content}</p>
      </article>
  ))
}

</body>
</html>
