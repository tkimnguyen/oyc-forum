---
import "../styles/global.css";

export interface Props {
  title?: string;
}

const { title = "OYC Forum" } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/jpeg" href="/oyc-logo.jpg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
</head>
<body>
  <div class="page">
    <header class="site-header">
      <a href="/">
        <img src="/oyc-logo.jpg" alt="Oshkosh Yacht Club" />
      </a>
    </header>
    <div class="wave-divider"></div>
    <slot />
  </div>
</body>
</html>
