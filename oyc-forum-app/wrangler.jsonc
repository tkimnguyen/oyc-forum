{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "oyc-forum",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oyc-forum-db",
			"database_id": "03cb5e68-ff9e-4e19-a5e7-502fd1aab51a"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "oyc-forum-attachments"
		}
	],
	"observability": {
		"enabled": true
	}
}
